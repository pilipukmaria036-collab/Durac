<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.durak.ui.MainMenuController"
           prefWidth="1280"
           prefHeight="720">

    <VBox alignment="CENTER" spacing="14" maxWidth="420">

        <ImageView fx:id="logoView"
                   fitWidth="460"
                   preserveRatio="true"
                   smooth="true"/>

        <Label text="ПІДКИДНИЙ ДУРЕНЬ" styleClass="menu-tagline"/>

        <VBox alignment="CENTER" spacing="12" maxWidth="340">
            <Button text="♠   Гра проти комп'ютера"
                    onAction="#onBotGameClick"
                    maxWidth="Infinity" prefHeight="54"
                    styleClass="menu-button, menu-button-primary"/>

            <Button text="♥   Локальна гра (2–4 людей)"
                    onAction="#onLocalGameClick"
                    maxWidth="Infinity" prefHeight="50"
                    styleClass="menu-button"/>

            <Button text="♦   Навчання"
                    onAction="#onTutorialClick"
                    maxWidth="Infinity" prefHeight="50"
                    styleClass="menu-button"/>

            <Button text="♣   Налаштування"
                    onAction="#onSettingsClick"
                    maxWidth="Infinity" prefHeight="50"
                    styleClass="menu-button"/>

            <Button text="Вихід"
                    onAction="#onExitClick"
                    maxWidth="Infinity" prefHeight="44"
                    styleClass="menu-button, menu-button-quiet"/>
        </VBox>
    </VBox>
</StackPane>
